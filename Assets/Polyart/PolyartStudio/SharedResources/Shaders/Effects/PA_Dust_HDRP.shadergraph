    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DustColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float4 c = SAMPLE_TEXTURE2D(ColorMap.tex, ColorMap.samplerstate, UV);\nRGB   = c.rgb * Tint.rgb * Intensity;\nAlpha = c.a * Tint.a;\n"
}

