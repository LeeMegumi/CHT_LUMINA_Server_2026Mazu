    "m_SourceType": 1,
    "m_FunctionName": "ColorTint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float4 c = SAMPLE_TEXTURE2D(ColorMap.tex, ColorMap.samplerstate, UV);\nRGB   = c.rgb * Tint.rgb;\nAlpha = c.a;\n"
}

